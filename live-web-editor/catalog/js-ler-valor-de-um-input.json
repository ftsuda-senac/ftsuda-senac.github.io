{"type":"JS","title":"Ler valor de um input","description":"Lê o valor digitado em um campo.","html":"<input id=\"name\" placeholder=\"Digite seu nome\" />\n<button id=\"button\">Mostrar</button>\n<pre id=\"result\"></pre>","css":"","javascript":"document.querySelector('#button').addEventListener('click', () => {\n  const nome = document.querySelector('#name').value;\n  document.querySelector('#result').textContent = nome;\n});","assets":[]}