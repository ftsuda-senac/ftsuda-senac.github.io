{"type":"JS","title":"Alterar classes com classList","description":"Adiciona e remove uma classe com classList.toggle.","html":"<p id=\"text\">Clique no botão</p>\n<button id=\"button\">Alternar classe</button>","css":".active { color: red; font-weight: bold; }","javascript":"document.querySelector('#button').addEventListener('click', () => {\n  document.querySelector('#text').classList.toggle('active');\n});","assets":[]}